RESEARCHIQ_ENVIRONMENT=development
RESEARCHIQ_CORS_ORIGINS=http://localhost:5173
RESEARCHIQ_DATA_DIR=data
RESEARCHIQ_DATABASE_URL=sqlite:///data/researchiq.db
RESEARCHIQ_MAX_UPLOAD_MB=25
RESEARCHIQ_MAX_PAGES=500
RESEARCHIQ_CHUNK_STRATEGY=fixed
RESEARCHIQ_CHUNK_SIZE=800
RESEARCHIQ_CHUNK_OVERLAP=150
RESEARCHIQ_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RESEARCHIQ_EMBEDDING_BATCH_SIZE=32
# SQLite is the default. For PostgreSQL + pgvector, uncomment:
# RESEARCHIQ_DATABASE_URL=postgresql+psycopg://researchiq:researchiq_dev@127.0.0.1:5432/researchiq